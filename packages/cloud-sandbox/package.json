{
  "name": "@orca/cloud-sandbox",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --target node22",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' '*.{json,md}'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' '*.{json,md}'"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^1.0.0",
    "@orca/sandbox-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
