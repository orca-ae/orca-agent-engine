{
  "name": "@orca/registry-service-ts",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts src/migrate.ts src/bootstrap-admin.ts src/create-admin-key.ts src/create-platform-key.ts --format esm --dts --target node22",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts test/integration",
    "test:e2e:internal-auth-kubernetes": "vitest run -c vitest.integration.config.ts test/integration/internal-auth-kubernetes.e2e.spec.ts",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.mjs'",
    "proto:gen": "buf generate --template buf.gen.yaml ../proto",
    "anthropic:sync": "node scripts/sync-anthropic-spec.mjs",
    "openapi:gen": "tsx scripts/generate-openapi.mjs && tsx scripts/generate-observability-openapi.mjs",
    "openapi:observability:gen": "tsx scripts/generate-observability-openapi.mjs",
    "conformance:gen": "node scripts/generate-conformance.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "registry:bootstrap-admin": "tsx src/bootstrap-admin.ts",
    "registry:create-admin-key": "tsx src/create-admin-key.ts",
    "registry:create-platform-key": "tsx src/create-platform-key.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@bufbuild/protobuf": "^2.2.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/websocket": "^11.0.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@grpc/grpc-js": "^1.12.0",
    "@kubernetes/client-node": "^0.22.0",
    "@orca/agent-event-contract": "workspace:*",
    "@orca/cloud-sandbox": "workspace:*",
    "@orca/file-store": "workspace:*",
    "@orca/guardrails": "workspace:*",
    "@orca/harness-catalog": "workspace:*",
    "@orca/harness-tunnel": "workspace:*",
    "@orca/memory-store": "workspace:*",
    "@orca/sandbox-runtime": "workspace:*",
    "@orca/skill-store": "workspace:*",
    "@orca/transcript-store": "workspace:*",
    "@ts-rest/core": "^3.51.0",
    "argon2": "^0.41.0",
    "cron-parser": "^5.10.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "jose": "^5.9.0",
    "js-yaml": "^4.1.1",
    "kafkajs": "^2.2.4",
    "nanoid": "^5.0.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.0",
    "uuid": "^11.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.113.0",
    "@apidevtools/swagger-parser": "12.1.0",
    "@oasdiff-js/oasdiff-js": "^1.0.0",
    "@ts-rest/open-api": "3.52.1",
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@types/ws": "^8.5.0",
    "ajv": "^8.17.1",
    "drizzle-kit": "^0.30.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
