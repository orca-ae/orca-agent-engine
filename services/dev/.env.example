# Local-stack env template — copy to services/dev/.env and customize.
#
# `services/dev/scripts/start-services.sh` sources `services/dev/.env` if it
# exists, otherwise it falls back to the same defaults listed below (which
# already match `services/dev/docker-compose.yml`). The .env file is gitignored.
#
# Set the model provider credential for your harness: ANTHROPIC_API_KEY for
# Claude, OPENAI_API_KEY for Codex/Pi, or DEEPSEEK_API_KEY for Pi.

# ----- Postgres (compose: services/dev/docker-compose.yml — postgres:16) -----
DATABASE_URL=postgres://orca:orca@localhost:5432/registry
# One of: kafka | postgres | pulsar.
TRANSCRIPT_STORE_BACKEND=kafka
TRANSCRIPT_STORE_DATABASE_URL=postgres://orca:orca@localhost:5432/transcriptstore
FILESTORE_DATABASE_URL=postgres://orca:orca@localhost:5432/filestore
MEMORYSTORE_DATABASE_URL=postgres://orca:orca@localhost:5432/memorystore

# ----- cron Trigger worker (runs in registry-service-ts) --------------------
# Set false on API-only Registry replicas. All enabled replicas coordinate via
# Postgres; no separate scheduler service or leader election is required.
TRIGGER_SCHEDULER_ENABLED=true
TRIGGER_RECONCILE_INTERVAL_MS=5000
TRIGGER_RECONCILE_BATCH_SIZE=100

# ----- Kafka (compose: KRaft single-node, auto-create topics) ---------------
KAFKA_BROKERS=localhost:9092
# Kafka connection mode. One of: plaintext | sasl-plain-token-tls | sasl-plain-tls | custom.
# Plaintext is the local-stack / CI default.
KAFKA_CONNECTION_MODE=plaintext
# Optional transcript envelope. Default raw needs no Schema Registry.
# The isolated real Kafka/Schema Registry fixture is independent of this file:
# bash services/dev/scripts/test-transcript-avro.sh
KAFKA_TRANSCRIPT_ENCODING=raw
# Avro + Registry URL selects .events-avro for all sessions; raw stays on .events.
# Quiesce turns; restart registry/harness/exporter together with the same encoding.
# Incompatible cutover: no history/cursor migration; use fresh sessions.
# Exporter state precautions: docs/operation/kafka-transcript-avro.md.
# KAFKA_SCHEMA_REGISTRY_URL=http://localhost:18081
# KAFKA_SCHEMA_REGISTRY_SUBJECT=orca.transcript.TranscriptEvent
# KAFKA_SCHEMA_REGISTRY_AUTO_REGISTER=true
# KAFKA_SCHEMA_REGISTRY_REQUEST_TIMEOUT_MS=5000
# Registry credentials are independent of Kafka credentials; Basic requires HTTPS.
# KAFKA_SCHEMA_REGISTRY_AUTH_MODE=basic
# KAFKA_SCHEMA_REGISTRY_USERNAME=
# KAFKA_SCHEMA_REGISTRY_PASSWORD=
# KAFKA_SCHEMA_REGISTRY_CA_FILE=
# KAFKA_SCHEMA_REGISTRY_CERT_FILE=
# KAFKA_SCHEMA_REGISTRY_KEY_FILE=
# Token-prefixed SASL/PLAIN over TLS (password token:<jwt>), e.g. Kafka-on-Pulsar (KoP):
# KAFKA_CONNECTION_MODE=sasl-plain-token-tls
# KAFKA_BROKERS=<bootstrap>:9093
# KAFKA_AUTH_TOKEN=<jwt>
# KAFKA_SASL_USERNAME=public
# Broker-native observability exporter only: explicitly opt into KoP bare topic listings.
# Default canonical is independent of authentication. Registry/harness ignore this setting.
# KAFKA_TOPIC_LISTING_MODE=bare-alias
# Any Kafka-compatible backend with SASL/PLAIN over TLS:
# KAFKA_CONNECTION_MODE=sasl-plain-tls
# KAFKA_BROKERS=<bootstrap>:9093
# KAFKA_SASL_USERNAME=<userName>
# KAFKA_AUTH_TOKEN=<jwt>
# Custom KafkaJS plain SASL/TLS:
# KAFKA_CONNECTION_MODE=custom
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_REJECT_UNAUTHORIZED=true
# KAFKA_SSL_CA_FILE=
# KAFKA_SSL_CERT_FILE=
# KAFKA_SSL_KEY_FILE=
# Optional topic prefix (dot-terminated segments). Kafka-on-Pulsar (KoP)
# endpoints map dotted Kafka topic names to <tenant>.<namespace>.<topic>,
# so session topics need an existing tenant/namespace prefix there. Leave
# unset for plain Kafka (bare topic names).
# KAFKA_TOPIC_PREFIX=public.default.
# Used only when TRANSCRIPT_STORE_BACKEND=kafka.
# The harness dispatcher polls every `KAFKA_TOPIC_REDISCOVER_INTERVAL_MS` ms,
# turns that one metadata snapshot into an explicit canonical topic list, and
# replaces its consumer when the list changes. 5_000 (5 s) keeps
# `pnpm e2e:agent` snappy without hammering the broker; production defaults to
# 30 seconds. Kafka config rejects non-positive values.
KAFKA_TOPIC_REDISCOVER_INTERVAL_MS=5000

# ----- Pulsar (compose: standalone, optional transcript backend) ------------
PULSAR_SERVICE_URL=pulsar://localhost:6650
PULSAR_TENANT=public
PULSAR_NAMESPACE=default
PULSAR_TOPIC_PREFIX=orca
PULSAR_RECEIVE_TIMEOUT_MS=500
# PULSAR_ACK_TIMEOUT_MS=30000
# PULSAR_AUTH_TYPE=token
# PULSAR_AUTH_TOKEN=
# PULSAR_AUTH_TYPE=oauth2
# PULSAR_OAUTH2_TYPE=client_credentials
# PULSAR_OAUTH2_ISSUER_URL=
# PULSAR_OAUTH2_CLIENT_ID=
# PULSAR_OAUTH2_CLIENT_SECRET=
# PULSAR_OAUTH2_PRIVATE_KEY=
# PULSAR_OAUTH2_AUDIENCE=
# PULSAR_OAUTH2_SCOPE=

# ----- RustFS (compose: rustfs + rc bucket bootstrap → bucket=orca-files) -----
S3_ENDPOINT=http://localhost:9000
# RustFS serves its STS API on the same endpoint. Production normally
# leaves this unset so the AWS SDK selects the regional STS endpoint.
S3_STS_ENDPOINT=http://localhost:9000
S3_BUCKET=orca-files
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Aliases — config.ts prefers _ID/_ACCESS_KEY when both are present.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Shared storage root. File, memory and output builders append canonical
# workspace/resource segments beneath it.
S3_KEY_PREFIX=managed-agents/
ALLOW_INSECURE_STATIC_S3_CREDS=true

# ----- session JWT (registry mints, ai-gateway verifies) --------------------
# `start-services.sh` overwrites this at boot with the contents of
# services/dev/secrets/session-jwt.pem (generated by init-secrets.sh).
# Set explicitly only if you want to use your own keypair.
# SESSION_JWT_PRIVATE_KEY_PEM=services/dev/secrets/session-jwt.pem
SESSION_JWT_ISSUER=orca-registry
SESSION_JWT_AUDIENCE=ai-gateway
SESSION_JWT_TTL_SECS=300
# Optional deployment-wide LLM policy. The gateway ACL requires these claims
# for /v1/messages; Registry intersects the model pattern with each session's
# concrete pinned model before minting the JWT.
SESSION_JWT_LLM_ROUTES=llm-messages
SESSION_JWT_LLM_MODELS=claude-sonnet-4-6
# LocalSecretStore is accepted only in an explicit development/test runtime.
NODE_ENV=development
ORCA_SECRET_STORE_MODE=local

# ----- Registry internal API auth ------------------------------------------
# Non-Kubernetes runs use a shared high-entropy service token. stack-up creates
# services/dev/run/internal-service-token automatically and gives its path to
# Registry, Harness, and ai-gateway. Set exactly one of these only when you
# need a stable externally-managed value; start-services.sh normalizes it into
# the private runtime file before launching services.
# INTERNAL_SERVICE_TOKEN=<at-least-32-character-random-token>
# INTERNAL_SERVICE_TOKEN_FILE=/absolute/path/to/internal-service-token

# ----- ai-gateway image -----------------------------------------------------
# Keep configurable so local-stack can test newer gateway release candidates
# without source changes. The selected image must support JWT-derived LLM
# route/model scope authorization, rotating HTTP vault bearer tokens, and
# Registry-backed wildcard `destination_resolver` routing.
# `stack-up` runs positive capability probes and fails fast on older images.
AI_GATEWAY_IMAGE=ghcr.io/orca-ae/orca-ai-gateway:v0.4.2-rc.1

# Deterministic plaintext that the e2e-tests seed helper writes into Postgres.
# It is a test-client credential only; the Harness never receives it.
ORCA_E2E_PLAINTEXT_KEY=orca_dev_e2e_local_stack

# ----- service URLs (used by harness when wiring sandbox env) ---------------
REGISTRY_BASE_URL=http://localhost:8080
REGISTRY_INTERNAL_BASE_URL=http://localhost:8081
REGISTRY_ADMIN_BASE_URL=http://localhost:8082
AI_GATEWAY_URL=http://localhost:8090/v1/mcp
AI_GATEWAY_ADMIN_PORT=9099
# Anthropic-compatible LLM proxy route exposed by ai-gateway. The in-sandbox
# harness receives this as LITELLM_API_BASE plus a session JWT API key.
LLM_GATEWAY_URL=http://localhost:8090/v1

# ----- harness sandbox runtime ---------------------------------------------
# Required (no silent default). One of: local | e2b | in-memory | opensandbox.
#  - local      → uses `srt` (npm install -g @anthropic-ai/sandbox-runtime)
#  - e2b        → uses E2B cloud sandboxes; also requires E2B_API_KEY
#  - opensandbox → uses a remote OpenSandbox server; for local-to-GKE debug,
#                  run: kubectl -n opensandbox-system port-forward svc/opensandbox-server 18080:80
#  - in-memory  → null sandbox, no isolation (test-only)
SANDBOX_RUNTIME=local
HARNESS_WORK_DIR=/var/tmp/orca-harness
SESSION_IDLE_TIMEOUT_MS=60000

# ----- OpenSandbox (only set when SANDBOX_RUNTIME=opensandbox) --------------
# OPEN_SANDBOX_DOMAIN=localhost:18080
# OPEN_SANDBOX_PROTOCOL=http
# OPEN_SANDBOX_API_KEY=
# Use the Orca image documented at
# services/harness-server/sandbox-templates/orca-opensandbox/README.md; the
# stock code-interpreter image is not assumed to contain bubblewrap or FUSE
# userspace tools. Patched server must operator-allowlist exact image digest +
# entrypoint and expose /dev/fuse. OpenSandbox rejects runtime package installs;
# FUSE acquisitions reject pause/resume until live mounts can be reconstructed.
# OPEN_SANDBOX_IMAGE=<registry>/orca-opensandbox-code-interpreter@sha256:<digest>
# OPEN_SANDBOX_ENTRYPOINT=/opt/code-interpreter/code-interpreter.sh
# OPEN_SANDBOX_TIMEOUT_SECONDS=1800
# OPEN_SANDBOX_USE_SERVER_PROXY=true
# OPEN_SANDBOX_REQUEST_TIMEOUT_SECONDS=30

# ----- Anthropic credentials (REQUIRED for any real session) ----------------
# Without this the harness boot still succeeds but the first session fails
# with an unauthenticated Anthropic error. Get one from https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# ----- optional ports (defaults match docs + Makefile) ----------------------
# REGISTRY_HTTP_PORT=8080
# REGISTRY_INTERNAL_HTTP_PORT=8081
# REGISTRY_ADMIN_HTTP_PORT=8082
# HARNESS_HTTP_PORT=9094
# AI_GATEWAY_ADMIN_PORT=9099

# ----- E2B (only set when SANDBOX_RUNTIME=e2b) ------------------------------
# E2B_API_KEY=
# E2B_TEMPLATE_ID=

# Codex SDK separate direct egress (harness-server). Model comes from the Agent.
OPENAI_API_KEY=
# Optional OpenAI Responses-compatible provider endpoint; defaults to OpenAI.
OPENAI_BASE_URL=

# Pi SDK DeepSeek direct egress and the dev gateway llm-chat vault.
DEEPSEEK_API_KEY=
# Optional direct Chat Completions endpoint; the gateway uses its destination config.
DEEPSEEK_BASE_URL=

# Pi-only static API-key providers; optional explicit env-name mappings.
# PI_SDK_PROVIDER_CREDENTIALS={"zai":{"apiKeyEnv":"ZAI_API_KEY","baseUrlEnv":"ZAI_BASE_URL"}}
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
# ZAI_API_KEY=
# ZAI_BASE_URL=
# Pi Gateway config generated with scripts/render-pi-gateway-config.mjs.
# Requires a Gateway image with native_api_key support; legacy config is the default.
# AI_GATEWAY_CONFIG_FILE=./run/pi-gateway-config.yaml
