diff --git a/orca-build.cjs b/orca-build.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..fc60c74de93de5396ed5b391f2fb3242991df4d5
--- /dev/null
+++ b/orca-build.cjs
@@ -0,0 +1,104 @@
+// Build the patched binding, never the upstream prebuilt with unsafe Reader
+// error handling. Use the same statically linked C++ client as upstream 1.17.0.
+const { createHash } = require('node:crypto');
+const { execFileSync } = require('node:child_process');
+const { copyFileSync, cpSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } = require('node:fs');
+const { dirname, join } = require('node:path');
+const { setTimeout: sleep } = require('node:timers/promises');
+
+const baseUrl = 'https://archive.apache.org/dist/pulsar/pulsar-client-cpp-4.1.0/';
+const artifacts = {
+  'linux-glibc-x64': ['deb-x86_64/apache-pulsar-client-dev.deb',
+    'fa8edf393686c3cf929e637a86ca8f0afb7190c98448ac46edde49e5541023a9ba3080af69bfe7ad9e155c991db805c14ddaaba6675f54d51c87840b1b9f7b48'],
+  'linux-glibc-arm64': ['deb-arm64/apache-pulsar-client-dev.deb',
+    'a7ea7a84e398f5a710cc5f5fa9d0cbf31bd4ca86da6b0a913c5965b5a6023300e4aaa1fc0e9554f4863246aa026fd95cad53389a48300c378d52ff5dbefb4573'],
+  'linux-musl-x64': ['apk-x86_64/x86_64/apache-pulsar-client-dev-4.1.0-r0.apk',
+    '8a5b72a2026c523489a5d4d0f1fe99501f3dde9a9424f6fda638727140cb9ed2dd4bb4657503501f21a3c3b0b26c9885ba13af792409af8daf21ecfbf066849b'],
+  'linux-musl-arm64': ['apk-arm64/aarch64/apache-pulsar-client-dev-4.1.0-r0.apk',
+    'f9dba35e02ffcbaacdc3fc3840132b4526fe547eacb0bb18f315dad0e51845679d22a7d8b03925ad045e6dabbb1ec8d9d7f931c809eeda8a30ec0207fee40bad'],
+  'darwin-x64': ['macos-x86_64.zip',
+    'b053cf1c20f56ad2fbd9e42b5c631636f4e6c6f702b67d6aebe5bf48287aa8a7476ab55353363853bdd473a566f332a12ce9f8609e29cbc193e8bf037bb9f5cd'],
+  'darwin-arm64': ['macos-arm64.zip',
+    'bb8f371e7f9e31c748d4262c7b4fda204157c590c53ad6371ef09801e3c26da49c9801cee7c71a09302817c06e9ea9a303a65c1d45055639884668218f8a0fac'],
+};
+
+async function downloadArchive(name) {
+  const url = baseUrl + name;
+  for (let attempt = 1; attempt <= 3; attempt++) {
+    let status;
+    try {
+      // The deadline covers both response headers and the complete body.
+      const response = await fetch(url, { signal: AbortSignal.timeout(300_000) });
+      status = response.status;
+      if (!response.ok) {
+        await response.body?.cancel().catch(() => {});
+        throw new Error(`HTTP ${status}`);
+      }
+      return Buffer.from(await response.arrayBuffer());
+    } catch (error) {
+      const retryable = status === undefined || status === 200 ||
+        status === 408 || status === 429 || (status >= 500 && status <= 599);
+      if (!retryable || attempt === 3) {
+        throw new Error(`C++ client download failed: ${url} after ${attempt} attempts: ${error.message}`, { cause: error });
+      }
+      const delay = attempt * 1_000;
+      console.warn(`C++ client download attempt ${attempt}/3 failed for ${url}: ${error.message}; retrying in ${delay}ms`);
+      await sleep(delay);
+    }
+  }
+}
+
+async function main() {
+  const libc = process.platform === 'linux'
+    ? (process.report.getReport().header.glibcVersionRuntime ? '-glibc' : '-musl') : '';
+  const target = `${process.platform}${libc}-${process.arch}`;
+  const artifact = artifacts[target];
+  if (!artifact) throw new Error(`Patched pulsar-client build is unsupported on ${target}`);
+  const [name, sha512] = artifact;
+  // pnpm's patch_hash= path breaks Makefile targets generated by node-gyp.
+  // On Linux pnpm also sets TMPDIR to that package directory. Use /tmp on our
+  // POSIX build targets, then copy only the finished static binding back.
+  const temp = mkdtempSync('/tmp/orca-pulsar-build-');
+  const destination = join(temp, process.platform === 'darwin'
+    ? 'pkg/mac/build-pulsar/install' : 'pkg/linux/pulsar-cpp');
+  const run = (command, args, cwd = temp) =>
+    execFileSync(command, args, { cwd, stdio: 'inherit', timeout: 300_000 });
+  try {
+    for (const file of ['package.json', 'binding.gyp']) {
+      copyFileSync(join(__dirname, file), join(temp, file));
+    }
+    cpSync(join(__dirname, 'src'), join(temp, 'src'), { recursive: true });
+    cpSync(dirname(require.resolve('node-addon-api')), join(temp, 'node_modules/node-addon-api'), { recursive: true });
+    console.log(`Building patched pulsar-client for ${target}`);
+    const bytes = await downloadArchive(name);
+    if (createHash('sha512').update(bytes).digest('hex') !== sha512) {
+      throw new Error('C++ client archive checksum mismatch');
+    }
+    const archive = join(temp, 'archive');
+    writeFileSync(archive, bytes);
+    mkdirSync(destination, { recursive: true });
+    if (process.platform === 'darwin') {
+      run('unzip', ['-q', archive, '-d', destination]);
+    } else if (libc === '-glibc') {
+      run('ar', ['x', archive], temp);
+      run('tar', ['-xJf', join(temp, 'data.tar.xz'), '--strip-components=2', '-C', destination, './usr']);
+    } else {
+      run('tar', ['-xzf', archive, '--strip-components=1', '-C', destination, 'usr']);
+    }
+    // QEMU compilation can exceed the archive commands' five-minute deadline.
+    // Let the enclosing CI job bound it, rather than killing only node-pre-gyp.
+    execFileSync(process.execPath, [require.resolve('@mapbox/node-pre-gyp/bin/node-pre-gyp'), 'rebuild'], {
+      cwd: temp,
+      stdio: 'inherit',
+    });
+    mkdirSync(join(__dirname, 'lib/binding'), { recursive: true });
+    copyFileSync(join(temp, 'lib/binding/pulsar.node'), join(__dirname, 'lib/binding/pulsar.node'));
+  } finally {
+    rmSync(temp, { recursive: true, force: true });
+  }
+}
+
+main().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
